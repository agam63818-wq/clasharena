# Example environment file — copy to .env for local client setup.
# .env is gitignored; never commit real values (permanent rule 1).
#
# Feature flags: the single authoritative table (what each flag needs in the
# database and its safe default) is in README.md → "Feature flags". Do not add
# flag names that are not in that table.

# ---------------------------------------------------------------------------
# CLIENT vars (VITE_*) — these are bundled into the public JavaScript.
# NEVER put the service role key or any secret here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# CLIENT feature flags — read in src/config/features.js.
# ---------------------------------------------------------------------------
# Payments. Needs a real payment provider + a server-side transaction write
# path — neither exists yet (rule 4: no fake payments). Keep false.
# VITE_FEATURE_PAYMENTS=false               # default: false
#
# Deposit/withdraw REQUESTS (no gateway). Needs the server flag below, the
# wallet_requests table and the approve/reject RPCs
# (supabase/proposed/005_wallet_requests.sql — NOT applied).
# While off, the wallet keeps the honest "coming soon" state.
# VITE_FEATURE_WALLET_REQUESTS=false        # default: false
#
# Public support contact shown in the wallet request form. Both values are
# PUBLIC (VITE_ vars are bundled into the browser JS): the WhatsApp number is
# a display-only contact and the UPI ID is for display only — it is NEVER
# used to verify a payment (permanent rule 4). Leave unset to hide the block.
# VITE_SUPPORT_WHATSAPP=+91XXXXXXXXXX
# VITE_SUPPORT_UPI=yourupi@bank
#
# Room credentials via get_room_details() (auth.uid()-based security-definer
# RPC -> supabase/proposed/003_functions_triggers.sql §3). Not applied yet.
# VITE_FEATURE_ROOM_RPC=false               # default: false
#
# Wallet transaction list. Needs the transactions table + RLS policy
# user_id = auth.uid(). Can be turned off for an honest "unavailable" state.
# VITE_FEATURE_WALLET_TRANSACTIONS=true     # default: true
#
# Completed-tournament standings. The tournament_results table and player-safe
# read policy are deployed. Set false only to show the honest unavailable
# state while diagnosing that database feature.
# VITE_FEATURE_TOURNAMENT_RESULTS=true      # default: true

# ---------------------------------------------------------------------------
# SERVER-ONLY vars — set these in Vercel Project Settings -> Environment
# Variables, NOT in any VITE_ prefixed name. The service role key bypasses
# RLS; exposing it to the browser would compromise the whole database.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER feature flags — read inside api/*.
# Atomic join via join_tournament(p_user_id, p_tournament_id, p_ff_uid, p_ign),
# granted to service_role only; the API passes the token-verified user id.
# Requires the function from supabase/proposed/003_functions_triggers.sql §2.
# JOIN_USE_RPC=false                        # default: false (legacy path)
#
# Wallet-request flow kill switch (create/list/approve/reject). Needs the
# wallet_requests table + approve/reject RPCs (005). While off, every
# wallet-request action answers 503 and no money can move.
# ENABLE_WALLET_REQUESTS=false              # default: false
#
# Per-user hourly cap on wallet requests (a DB count over the last hour, not
# an in-memory counter — see api/wallet.js). Coarse abuse brake, not a
# billing-grade limiter.
# WALLET_REQUESTS_PER_HOUR=5                # default: 5
#
# Cancellation-with-refunds for tournaments that have PAID registrations.
# Needs cancel_tournament_with_refund() (006). Tournaments without paid
# registrations are cancelled without this flag. While off, the cancel action
# returns 409 with the exact reason and changes nothing.
# ENABLE_TOURNAMENT_CANCELLATION=false      # default: false
#
# Tournament-results writer. Uses the deployed admin_set_tournament_results()
# RPC to replace standings and mark a tournament completed. Defaults on because
# the database piece exists; set false to make the admin route return an honest
# 503 without changing results or tournament status.
# ENABLE_TOURNAMENT_RESULTS=true             # default: true
