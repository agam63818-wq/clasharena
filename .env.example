# Example environment file — copy to .env for local client setup.
# .env is gitignored; never commit real values (permanent rule 1).

# ---------------------------------------------------------------------------
# CLIENT vars (VITE_*) — these are bundled into the public JavaScript.
# NEVER put the service role key or any secret here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional client feature flags (permanent rule 7). Defaults shown.
# VITE_FEATURE_WALLET_TRANSACTIONS=false  # default: true
# VITE_FEATURE_PAYMENTS=true              # default: false (no provider yet)
# VITE_FEATURE_ROOM_RPC=true              # default: false (DB phase)

# ---------------------------------------------------------------------------
# SERVER-ONLY vars — set these in Vercel Project Settings -> Environment
# Variables, NOT in any VITE_ prefixed name. The service role key bypasses
# RLS; exposing it to the browser would compromise the whole database.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JOIN_USE_RPC=true                        # atomic join_tournament() (DB phase)
# ENABLE_TOURNAMENT_CANCELLATION=true      # refunds flow — not implemented yet
